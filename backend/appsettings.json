{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "EkipMeet.Api",
    "Audience": "EkipMeet.Mobile",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "WebRtc": {
    "IceServers": [
      { "Urls": [ "stun:stun.l.google.com:19302", "stun:stun1.l.google.com:19302" ] }
    ]
  },
  "FileStorage": {
    "LocalPath": "App_Data/uploads"
  },
  "Push": {
    "Enabled": true
  }
}